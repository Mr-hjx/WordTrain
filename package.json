{
  "name": "kids-english-uniapp",
  "version": "1.0.0",
  "description": "单词小火车 —— 幼儿英语每日趣味练习（uni-app + Vue3 + Vite + TS）",
  "private": true,
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "type-check": "vue-tsc --noEmit",
    "test:e2e": "node tests/e2e-acceptance.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030120260930001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030120260930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@vue/runtime-core": "^3.4.21",
    "sass": "^1.77.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.16"
  },
  "keywords": [
    "uniapp",
    "vue3",
    "english",
    "kids",
    "education",
    "miniprogram"
  ],
  "license": "MIT"
}